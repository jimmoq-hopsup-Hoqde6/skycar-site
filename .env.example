SKYCAR_ENV=demo
# Required for staging/production: exact HTTPS origin, no trailing slash.
# Local demo mode can infer a loopback origin without this variable.
# SKYCAR_APP_ORIGIN=https://your-isolated-test-host.example
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
FEATURE_GARAGE=true
FEATURE_CARE=false
FEATURE_BENEFITS=false
FEATURE_SELL=false
