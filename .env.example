SKYCAR_ENV=demo
# Required for staging/production: exact HTTPS origin, no trailing slash.
# Local demo mode can infer a loopback origin without this variable.
# SKYCAR_APP_ORIGIN=https://your-isolated-test-host.example
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
FEATURE_GARAGE=true
FEATURE_CARE=false
FEATURE_BENEFITS=false
FEATURE_SELL=false
# Customer support contact shown when an area check says "not serviced" or cannot be completed.
# The email defaults to info@skycar.au (public, non-secret; set in src/domain/care/support-contact.ts).
# SKYCAR_SUPPORT_EMAIL overrides it when set to a valid address; blank or invalid keeps the default.
# The phone has no default and stays hidden until SKYCAR_SUPPORT_PHONE is set to a valid number.
# SKYCAR_SUPPORT_EMAIL=
# SKYCAR_SUPPORT_PHONE=
